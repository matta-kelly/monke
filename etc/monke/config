# monke's config for every person on the machine. The image installs it at /etc/monke/config.
# A person changes a value in ~/.config/monke/config, which is read after this file.

# help, main: a model on the internet, through pi's own provider.
MONKE_MAIN_PROVIDER=fireworks
MONKE_MAIN_MODEL=accounts/fireworks/routers/deepseek-flash-latest
# The file that holds the API key. Each person's dotfiles write it from their vault. With no file, pi uses its own login.
MONKE_KEY_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/monke/key"

# help, local: a small model on the laptop, run by llama-server only while help is open.
# monke-model.service downloads it on the first boot that is online.
MONKE_LOCAL_MODEL=/var/lib/monke/models/Llama-3.2-3B-Instruct-Q4_K_M.gguf
MONKE_LOCAL_PORT=8765

# wtf: a line shown under its first line. A person sets their own in ~/.config/monke/config
MONKE_WTF_MESSAGE=
