#!/usr/bin/env bash
# monke: the front door of Monkeyworks. Each command runs the machine's own tools, and prints each command before it
# runs it, so you see what it does and can run it yourself.
#   + cmd   a command that does something
#   ? cmd   a check: it changes nothing
#
# Each person can call it by their own name: a symlink to this file. It names itself by the name it was called by.
set -euo pipefail

me=$(basename "$0")
version=dev # a release stamps its tag here (scripts/dist.sh)

# Config: the system file from the image, then the person's own file. A later value replaces an earlier one.
MONKE_DOCS=/usr/share/doc/monkeyworks
MONKE_SHARE=/usr/share/monke
MONKE_KEYS=/usr/libexec/monke-keys
MONKE_MAIN_PROVIDER=fireworks
MONKE_MAIN_MODEL=
MONKE_KEY_FILE=
MONKE_LOCAL_MODEL=
MONKE_LOCAL_PORT=8765
MONKE_WTF_MESSAGE=
for file in /etc/monke/config "${XDG_CONFIG_HOME:-$HOME/.config}/monke/config"; do
  if [ -r "$file" ]; then
    # shellcheck source=/dev/null
    . "$file"
  fi
done

# Print a command, then run it.
run() {
  printf '+ %s\n' "$*" >&2
  "$@"
}

# Print a check, then run it with no output. Its exit code is the answer.
check() {
  printf '? %s\n' "$*" >&2
  "$@" >/dev/null 2>&1
}

die() {
  echo "$me: $*" >&2
  exit 1
}

# Ask a yes/no question. Enter means yes.
ask() {
  local answer
  read -r -p "$1 [Y/n] " answer
  [[ -z $answer || $answer == [yY]* ]]
}

usage() {
  cat <<EOF
$me: the front door of this machine. Each command prints the commands it runs.

  $me status     what the system and apps are at, and what is staged
  $me update     update everything, or only the system, apps or settings
  $me rollback   go back to the previous system
  $me restart    restart the machine, after asking
  $me help ["<question>"]
                 a chat about this machine: local (on this laptop) or main (online)
  $me init       set up a new person, step by step
  $me wtf        your main keys at a glance; "$me wtf all" for every key
  $me version    the version of $me

The docs: $MONKE_DOCS
EOF
}

# The system's deployments (booted, staged, rollback), then the apps, then the app updates there are.
cmd_status() {
  run rpm-ostree status
  echo
  run flatpak list --app --columns=application,version,installation
  echo
  echo "app updates:"
  run flatpak remote-ls --updates --app --columns=application,version || echo "(none found, or offline)"
}

# What to update: everything, the system, the apps, or the settings. With no choice given it asks, and Enter is everything.
cmd_update() {
  local pick=${1:-}
  if [ -z "$pick" ]; then
    cat <<EOF
What do you want to update?
  1) everything: all three below
  2) system: the base of the machine, the same for everyone. It takes over at your next reboot
  3) apps: your programs, like Chrome and Spotify
  4) settings: your dotfiles, the config that makes this machine yours
EOF
    read -r -p "[1-4, Enter for everything] " pick
  fi
  case "$pick" in
    "" | 1 | everything | all) update_system && update_apps && update_settings ;;
    2 | system) update_system ;;
    3 | apps) update_apps ;;
    4 | settings | dotfiles) update_settings ;;
    *)
      echo "$me update: no choice '$pick'. Use everything, system, apps or settings" >&2
      exit 2
      ;;
  esac
  # A new system only takes over at a restart, so offer one at the end, after the apps and settings.
  if [ "${restart_due:-}" = yes ]; then
    echo
    echo "The new system takes over when you restart."
    cmd_restart
  fi
}

# The new system downloads now and takes over at the next reboot.
update_system() {
  echo "== system"
  run rpm-ostree upgrade
  local rc=0
  rpm-ostree status --pending-exit-77 >/dev/null || rc=$?
  if [ "$rc" = 77 ]; then
    echo "A new system is ready. To go back after the restart, run: $me rollback"
    restart_due=yes
  fi
}

# Restart the machine, after asking. Open work is lost, so it asks first.
cmd_restart() {
  if ask "Restart now? Save your work first."; then
    run systemctl reboot
  else
    echo "Not now. Restart when you are ready: $me restart"
  fi
}

update_apps() {
  echo "== apps"
  run flatpak update -y
}

# The person's dotfiles: pull their repo and apply it.
# chezmoi never gets to ask a question here: a locked vault and files changed on this laptop are both handled first,
# in plain words.
update_settings() {
  echo "== settings"
  if ! check chezmoi source-path; then
    echo "No settings repo here yet: $me init sets one up."
    return 0
  fi
  if ! check rbw unlocked; then
    echo "Your vault is locked. Your settings read their passwords and keys from it, so unlock it first."
    run rbw unlock || {
      echo "The vault is still locked, so your settings were not updated. Run $me update settings to try again."
      return 0
    }
  fi
  run chezmoi git -- pull --ff-only
  # Files changed on this laptop since chezmoi last wrote them: the first column of `chezmoi status`.
  local changed answer file targets=()
  changed=$(chezmoi status 2>/dev/null | awk 'substr($0, 1, 1) != " " { print substr($0, 4) }')
  if [ -z "$changed" ]; then
    run chezmoi apply --force
    return
  fi
  echo "These settings were changed on this laptop since your last update:"
  while IFS= read -r file; do echo "  ~/$file"; done <<<"$changed"
  read -r -p "Replace them with the update, or keep yours? [r = replace, Enter = keep yours] " answer
  if [[ $answer == [rR]* ]]; then
    run chezmoi apply --force
    return
  fi
  # Keep yours: apply every other file, and leave these as they are.
  while IFS= read -r file; do
    grep -qxF -- "$file" <<<"$changed" || targets+=("$HOME/$file")
  done < <(chezmoi managed --include=files,symlinks)
  if [ ${#targets[@]} -gt 0 ]; then run chezmoi apply --force "${targets[@]}"; fi
  echo "Kept yours. Everything else is updated."
}

# The previous system becomes the default at the next reboot. Running it again undoes it. Apps are not rolled back.
cmd_rollback() {
  run rpm-ostree rollback
  echo "The previous system takes over when you restart. To undo, run $me rollback again."
  cmd_restart
}

# A chat in pi about this machine, with pi's tools on: it reads, runs and edits, asking first as AGENTS.md says.
# Online, it asks local or main (Enter: local). Offline, it is local, and local opens with an offer to get on wifi.
cmd_help() {
  local state mode=local offline=no answer
  printf '? nmcli networking connectivity\n' >&2
  state=$(nmcli -t networking connectivity 2>/dev/null || echo unknown)
  if [ "$state" = full ]; then
    read -r -p "local or main? [L/m] " answer
    [[ $answer == [mM]* ]] && mode=main
  else
    echo "offline ($state): using the local model"
    offline=yes
  fi

  tmp=$(mktemp -d)
  trap 'cleanup' EXIT
  if [ "$mode" = main ]; then
    help_main "$@"
  else
    help_local "$offline" "$@"
  fi
}

# Run at exit: stop the local model if help started it, and delete the prompt files.
cleanup() {
  if [ -n "${server_pid:-}" ]; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
  rm -rf "${tmp:?}"
}

# The person's sway key bindings, read from their config now, for the model's context. Nothing when they cannot be read.
keys_section() {
  local keys
  keys=$("$MONKE_KEYS" 2>/dev/null) || return 0
  printf '\n# Key bindings\n\nThe person'"'"'s sway key bindings, read from their config just now. Super is the Windows key.\n\n%s\n' "$keys"
}

# The AGENTS.md files every chat loads: the machine's rules from the image, then the person's own, from their dotfiles.
# pi loads the person's own by itself only from its own config folder, and local uses another, so both are passed.
agents_files() {
  local file
  for file in "$MONKE_DOCS/AGENTS.md" "${PI_AGENT_HOME:-$HOME/.pi/agent}/AGENTS.md"; do
    [ -r "$file" ] && printf '%s\0' --append-system-prompt "$file"
  done
  return 0
}

# main: the person's own pi, its provider and model from the config, with every doc in the system prompt.
help_main() {
  local sys=$tmp/system.md file key
  [ -n "$MONKE_MAIN_MODEL" ] || die "no MONKE_MAIN_MODEL: set it in ~/.config/monke/config"
  {
    cat "$MONKE_SHARE/main.md"
    printf '\nCLI name: %s\n' "$me"
    keys_section
    printf '\n# The docs\n\n'
    for file in "$MONKE_DOCS"/*.md; do
      [ -r "$file" ] && [ "${file##*/}" != AGENTS.md ] || continue
      printf '=== %s ===\n%s\n\n' "${file##*/}" "$(<"$file")"
    done
  } >"$sys"
  local agents=()
  mapfile -d '' -t agents < <(agents_files)
  # The key goes to pi in its environment, never on a command line. With no key file, pi uses its own login.
  if [ -n "$MONKE_KEY_FILE" ] && [ -r "$MONKE_KEY_FILE" ]; then
    key=$(<"$MONKE_KEY_FILE")
    echo "(key: $MONKE_KEY_FILE)" >&2
    FIREWORKS_API_KEY=$key run pi --provider "$MONKE_MAIN_PROVIDER" --model "$MONKE_MAIN_MODEL" \
      --append-system-prompt "$sys" "${agents[@]}" "$@"
  else
    run pi --provider "$MONKE_MAIN_PROVIDER" --model "$MONKE_MAIN_MODEL" --append-system-prompt "$sys" "${agents[@]}" "$@"
  fi
}

# local: llama-server runs the model on this laptop while the chat is open, and pi talks to it through its own config,
# which knows only this model.
help_local() {
  local offline=$1 sys=$tmp/system.md agent="${XDG_STATE_HOME:-$HOME/.local/state}/monke/pi-local" i
  shift
  if [ ! -r "$MONKE_LOCAL_MODEL" ]; then
    echo "$me: the local model is not downloaded yet ($MONKE_LOCAL_MODEL)." >&2
    echo "It downloads by itself once the machine is online. To get online now, run: nmtui" >&2
    exit 1
  fi

  # --jinja: the model's own chat template, which tool calls need
  printf '+ llama-server -m %s --alias local --host 127.0.0.1 --port %s -c 8192 --jinja\n' "$MONKE_LOCAL_MODEL" "$MONKE_LOCAL_PORT" >&2
  llama-server -m "$MONKE_LOCAL_MODEL" --alias local --host 127.0.0.1 --port "$MONKE_LOCAL_PORT" -c 8192 --jinja \
    >"$tmp/llama-server.log" 2>&1 &
  server_pid=$!
  echo "loading the local model..." >&2
  for ((i = 0; i < 120; i++)); do
    curl -fs "http://127.0.0.1:$MONKE_LOCAL_PORT/health" >/dev/null 2>&1 && break
    kill -0 "$server_pid" 2>/dev/null || die "llama-server stopped: $(tail -5 "$tmp/llama-server.log")"
    sleep 1
  done
  [ "$i" -lt 120 ] || die "the local model did not load in 2 minutes"

  mkdir -p "$agent"
  jq -n --arg url "http://127.0.0.1:$MONKE_LOCAL_PORT/v1" \
    '{providers: {local: {baseUrl: $url, api: "openai-completions", apiKey: "none", models: [{id: "local", name: "local"}]}}}' \
    >"$agent/models.json"
  {
    cat "$MONKE_SHARE/local.md"
    printf '\nCLI name: %s\n' "$me"
    keys_section
    if [ "$offline" = yes ]; then
      echo
      cat "$MONKE_SHARE/offline.md"
    fi
  } >"$sys"
  # Offline with no question, local speaks first: it gets a first message, and opens with the wifi offer.
  if [ "$offline" = yes ] && [ $# -eq 0 ]; then
    set -- "I'm offline."
  fi
  local agents=()
  mapfile -d '' -t agents < <(agents_files)
  PI_CODING_AGENT_DIR=$agent run pi --provider local --model local --append-system-prompt "$sys" "${agents[@]}" "$@"
}

# The steps of the docs' setup (Each person), in order. A step that is done is skipped. Each step asks first.
cmd_init() {
  local url email repo
  echo "Setup for $(id -un). Each step checks first, and asks before it changes anything."

  echo
  echo "== the mesh"
  check tailscale status || die "this machine is not on the mesh. Do the machine setup first (setup, Machine)"

  echo
  echo "== the vault"
  if ! check rbw unlocked; then
    printf '? rbw config show\n' >&2
    if [ -z "$(rbw config show 2>/dev/null | jq -r '.base_url // empty')" ]; then
      read -r -p "Vaultwarden URL: " url
      read -r -p "your vault email: " email
      run rbw config set base_url "$url"
      run rbw config set email "$email"
    fi
    ask "Log in to the vault? It asks for your master password." && run rbw login && run rbw unlock
  fi

  echo
  echo "== GitHub"
  if ! check gh auth status; then
    ask "Log in to GitHub?" && run gh auth login --git-protocol https
  fi

  echo
  echo "== your dotfiles"
  if ! check test -d "$(chezmoi source-path 2>/dev/null)/.git"; then
    read -r -p "your dotfiles repo (for example github.com/<you>/dotfiles): " repo
    ask "Clone and apply $repo? It writes into your home." && run chezmoi init --apply "$repo"
  fi

  echo
  echo "== backup"
  local conf="${XDG_CONFIG_HOME:-$HOME/.config}/restic"
  if ! check test -r "$conf/env" -a -r "$conf/password"; then
    # The vault items are the ones the person's own restic templates read, never a name guessed here.
    local src items
    src=$(chezmoi source-path 2>/dev/null) || src=
    items=$(grep -rhoE 'rbw "[^"]+"' "$src/dot_config/private_restic" 2>/dev/null | sed 's/rbw "\(.*\)"/\1/' | sort -u)
    echo "No backup config in $conf. Your dotfiles write it from your vault."
    if [ -n "$items" ]; then
      echo "Your dotfiles' restic templates read these vault items. Make each, then run: chezmoi apply, then $me init again"
      local item
      while IFS= read -r item; do echo "  - $item"; done <<<"$items"
    else
      echo "Your dotfiles have no restic templates yet: add templates for $conf/env and $conf/password, then: chezmoi apply"
    fi
    cat <<'EOF'
Each item is a Secure Note, with its value in the notes:
  - the S3 item's notes, exactly this shape (placeholder values work while testing; backup needs the real ones):
    {"RESTIC_REPOSITORY":"s3:https://fsn1.your-objectstorage.com/<bucket>/restic","AWS_DEFAULT_REGION":"fsn1","AWS_ACCESS_KEY_ID":"<key>","AWS_SECRET_ACCESS_KEY":"<secret>"}
  - the password item's notes: a long random password, and nothing else
After changing an item in the web vault, run: rbw sync
EOF
    return
  fi
  # restic reads the repository and keys from the env file, and the password from its file.
  # shellcheck source=/dev/null
  restic_env() { (set -a && . "$conf/env" && set +a && "$@"); }
  if ! restic_env check restic -p "$conf/password" cat config; then
    ask "Create the backup repository?" && restic_env run restic -p "$conf/password" init
  fi
  printf '? restic -p %s snapshots --latest 1\n' "$conf/password" >&2
  if ! restic_env restic -p "$conf/password" snapshots --latest 1 --json 2>/dev/null | jq -e 'length > 0' >/dev/null 2>&1; then
    ask "Run the first backup now? It runs in the background; see it with: journalctl --user -u restic-backup -f" &&
      run systemctl --user start --no-block restic-backup
  fi

  echo
  echo "Done. Next: $me status. To restore a file, see backup in $MONKE_DOCS."
}

# The main keys at a glance, read live from the person's sway config. "all": every key.
cmd_wtf() {
  echo "$me wtf: your keys at a glance. Super is the Windows key."
  [ -z "$MONKE_WTF_MESSAGE" ] || printf '\n%s\n' "$MONKE_WTF_MESSAGE"
  echo
  if [ "${1:-}" = all ]; then
    "$MONKE_KEYS" || die "no sway keys found"
  else
    "$MONKE_KEYS" --main || die "no sway keys found"
    printf '\nEvery key: %s wtf all\n' "$me"
  fi
  printf 'Stuck? %s help, and ask. Updates: %s update\n' "$me" "$me"
}

cmd_version() { echo "$me $version"; }

case "${1:-}" in
  "" | -h | --help) usage ;;
  status | update | rollback | restart | help | init | wtf | version)
    cmd=$1
    shift
    "cmd_$cmd" "$@"
    ;;
  *)
    echo "$me: no command '$1'" >&2
    usage >&2
    exit 2
    ;;
esac
