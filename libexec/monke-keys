#!/usr/bin/python3
"""Print the person's sway key bindings, one per line: the keys, then what they do. With --main, only the main ones,
named in plain words.

It reads the config files sway reads, the way sway layers them: the main config, then the drop-ins from
/usr/share/sway/config.d, /etc/sway/config.d and ~/.config/sway/config.d, where a file in a later folder replaces one
with the same name in an earlier folder. `monke help` gives its output to the model.
"""

import os
import re
import sys
from pathlib import Path

home = Path(os.environ.get("HOME", "~")).expanduser()
xdg = Path(os.environ.get("XDG_CONFIG_HOME", home / ".config"))
root = Path(os.environ.get("MONKE_SWAY_ROOT", "/"))  # tests point this at a fake filesystem


def main_config() -> Path:
    own = xdg / "sway" / "config"
    return own if own.exists() else root / "etc/sway/config"


def drop_ins() -> list[Path]:
    layered: dict[str, Path] = {}
    for folder in (root / "usr/share/sway/config.d", root / "etc/sway/config.d", xdg / "sway" / "config.d"):
        for path in sorted(folder.glob("*.conf")) if folder.is_dir() else []:
            layered[path.name] = path
    return [layered[name] for name in sorted(layered)]


def lines(path: Path):
    """The config's lines, with comments dropped and backslash continuations joined."""
    joined = ""
    for raw in path.read_text(errors="replace").splitlines():
        line = raw.strip()
        if not joined and (not line or line.startswith("#")):
            continue
        if line.endswith("\\"):
            joined += line[:-1] + " "
            continue
        yield joined + line
        joined = ""
    if joined:
        yield joined


def readable(keys: str) -> str:
    return keys.replace("Mod4", "Super").replace("Mod1", "Alt")


variables: dict[str, str] = {}


def expand(text: str) -> str:
    for name in sorted(variables, key=len, reverse=True):
        text = text.replace("$" + name, variables[name])
    return text


def strip_flags(words: list[str]) -> list[str]:
    while words and words[0].startswith("--"):
        words = words[1:]
    return words


def short(command: str) -> str:
    command = " ".join(command.split())
    return command if len(command) <= 90 else command[:87] + "..."


def bindings(path: Path):
    mode = None  # the mode a block belongs to, such as "resize"
    in_block = False  # inside `bindsym {`
    for line in lines(path):
        if line.startswith("set ") and not in_block:
            parts = line.split(None, 2)
            if len(parts) == 3:
                variables[parts[1].lstrip("$")] = expand(parts[2])
            continue
        line = expand(line)
        if in_block:
            if line == "}":
                in_block = False
                continue
            words = strip_flags(line.split())
            if len(words) >= 2:
                yield mode, words[0], " ".join(words[1:])
            continue
        m = re.match(r'mode\s+(?:--\S+\s+)*"?([^"{]+?)"?\s*\{$', line)
        if m:
            mode = m.group(1)
            continue
        if line == "}" and mode:
            mode = None
            continue
        if line.startswith("bindsym"):
            words = strip_flags(line.split()[1:])
            if words == ["{"]:
                in_block = True
            elif len(words) >= 2:
                yield mode, words[0], " ".join(words[1:])


# The main keys: what each does, in plain words, and the command it runs. Found by the command, not the key, so a
# person who moves a key sees their own key.
MAIN = [
    ("open a terminal", r"^exec (foot|\S*/foot)\b"),
    ("open the app launcher", r"^exec rofi\b.*-show (drun|combi)"),
    ("close the window", r"^kill$"),
    ("fullscreen, on and off", r"^fullscreen$"),
    ("go to workspace 1 (2 to 9 the same way)", r"^workspace number 1$"),
    ("send the window to workspace 1", r"^move container to workspace number 1$"),
    ("move between windows", r"^focus (left|right|up|down)$"),
    ("screenshot: drag an area", r"grim -g"),
    ("screenshot: the whole screen", r"^exec .*\bgrim (?!-g)"),
    ("lock the screen", r"lock-session|swaylock"),
    ("reload settings, after a change", r"^reload$"),
    ("log out", r"swaynag.*exit|^exit$"),
]


def main() -> int:
    seen: dict[tuple, str] = {}  # a later binding of the same keys replaces an earlier one, as in sway
    for path in [main_config(), *drop_ins()]:
        if path.is_file():
            for mode, keys, command in bindings(path):
                seen[(mode, readable(keys))] = " ".join(command.split())
    if "--main" in sys.argv[1:]:
        width = max(len(label) for label, _ in MAIN)
        for label, pattern in MAIN:
            keys = [k for (mode, k), command in seen.items() if not mode and re.search(pattern, command)]
            arrows = [k for k in keys if k.split("+")[-1] in ("Left", "Right", "Up", "Down")]
            if label == "move between windows" and arrows:
                keys = [arrows[0].rsplit("+", 1)[0] + "+arrows"]  # four keys, said as one
            if keys:
                print(f"  {label:<{width}}  {'  or  '.join(keys[:2])}")
        return 0 if seen else 1
    for (mode, keys), command in seen.items():
        where = f"[{mode} mode] " if mode else ""
        print(f"{where}{keys}: {short(command)}")
    return 0 if seen else 1


if __name__ == "__main__":
    sys.exit(main())
